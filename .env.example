# Application
# Each service overrides APP_PORT in docker-compose:
#   payment-service 8080, payment-worker 8081, fake-gateway 8082.
APP_PORT=8080

# Database
# These values target running a service on your machine with `go run`.
# docker-compose overrides DB_HOST to "postgres" and DB_PORT to 5432 for the
# containers, which reach Postgres over the Docker network instead.
#
# Host port is 5433, not 5432: a native PostgreSQL 18 from the EDB installer
# already owns 5432 on this machine.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=design-payment-system
DB_SSLMODE=disable

# Kafka
# localhost:29092 is the host listener; docker-compose overrides this to
# kafka:9092 for the containers.
KAFKA_BROKERS=localhost:29092

# Payment gateway the worker charges against (the fake-gateway service).
# docker-compose overrides this to http://fake-gateway:8082.
GATEWAY_URL=http://localhost:8082
GATEWAY_TIMEOUT=5s

# fake-gateway test hook (empty in normal use). Set on the fake-gateway
# service to exercise the worker's failure paths:
#   decline -> every charge is refused (402)  -> payment goes to FAILED
#   error   -> every charge returns 500       -> worker retries, then DLQ
#   timeout -> the gateway hangs              -> client timeout, retry, DLQ
GATEWAY_FAIL_MODE=

# Webhook signing. Both sides hold this secret: fake-gateway signs callbacks
# with it, payment-service verifies them. Never commit a real one.
WEBHOOK_SECRET=dev-webhook-secret

# Where fake-gateway delivers callbacks. docker-compose overrides this to
# http://payment-service:8080/webhook/payment.
WEBHOOK_URL=http://localhost:8080/webhook/payment
